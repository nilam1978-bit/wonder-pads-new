{
  "name": "wonder-pads-new",
  "compatibility_date": "2024-01-01",
  "main": "src/worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "wonder-pads-images"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wonder-pads-db",
      "database_id": "0799ad98-a699-4f10-8c0d-16d482a5e9a7"
    }
  ]
}
